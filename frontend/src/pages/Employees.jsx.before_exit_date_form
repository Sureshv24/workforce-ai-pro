import { useEffect, useState } from "react";
import { getEmployees, createEmployee, updateEmployee, deleteEmployee, linkEmployeeAccount } from "../api/employees";
import { getDepartments } from "../api/departments";

const emptyForm = {
  employee_code: "",
  full_name: "",
  department_id: "",
  job_title: "",
  hire_date: "",
  employment_status: "Active",
};

export default function Employees() {
  const [employees, setEmployees] = useState([]);
  const [departments, setDepartments] = useState([]);
  const [form, setForm] = useState(emptyForm);
  const [editingId, setEditingId] = useState(null);
  const [search, setSearch] = useState("");
  const [departmentId, setDepartmentId] = useState("");
  const [page, setPage] = useState(1);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");
  const [loading, setLoading] = useState(false);
  const [linkingEmployee, setLinkingEmployee] = useState(null);
  const [accountEmail, setAccountEmail] = useState("");
  const [linking, setLinking] = useState(false);

  async function loadData() {
    setLoading(true);
    setError("");

    try {
      const params = { page, page_size: 100 };

      if (search.trim()) params.search = search.trim();
      if (departmentId) params.department_id = Number(departmentId);

      const [employeeResponse, departmentResponse] = await Promise.all([
        getEmployees(params),
        getDepartments({ page: 1, page_size: 100 }),
      ]);

      setEmployees(employeeResponse.data);
      setDepartments(departmentResponse.data);
    } catch (err) {
      setError(
        err.response?.status === 401
          ? "Your login session is invalid or expired. Please log in again."
          : err.response?.data?.detail || "Unable to load employees. Check the backend and your permissions."
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadData();
  }, [page, search, departmentId]);

  function handleChange(event) {
    setForm({ ...form, [event.target.name]: event.target.value });
  }

  async function handleSubmit(event) {
    event.preventDefault();
    setError("");

    const payload = {
      ...form,
      department_id: form.department_id ? Number(form.department_id) : null,
      hire_date: form.hire_date || null,
    };

    try {
      if (editingId !== null) {
        await updateEmployee(editingId, payload);
      } else {
        await createEmployee(payload);
      }

      setForm(emptyForm);
      setEditingId(null);
      await loadData();
    } catch (err) {
      setError(err.response?.data?.detail || "Unable to save employee.");
    }
  }

  function startEdit(employee) {
    setEditingId(employee.id);
    setForm({
      employee_code: employee.employee_code || "",
      full_name: employee.full_name || "",
      department_id: employee.department_id ?? "",
      job_title: employee.job_title || "",
      hire_date: employee.hire_date || "",
      employment_status: employee.employment_status || "Active",
    });

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  async function handleLinkAccount(event) {
    event.preventDefault();

    if (!linkingEmployee) return;

    const email = accountEmail.trim();
    if (!email) {
      setError("Enter the email address of an existing login account.");
      return;
    }

    setError("");
    setNotice("");
    setLinking(true);

    try {
      await linkEmployeeAccount(linkingEmployee.id, { email });

      setNotice(
        `Login account linked to ${linkingEmployee.full_name} successfully.`
      );
      setLinkingEmployee(null);
      setAccountEmail("");
      await loadData();
    } catch (err) {
      const detail = err.response?.data?.detail;
      setError(
        typeof detail === "string"
          ? detail
          : "Unable to link the login account. Verify the email and your permissions."
      );
    } finally {
      setLinking(false);
    }
  }

  async function handleDelete(employee) {
    if (!window.confirm(`Delete ${employee.full_name}?`)) return;

    setError("");

    try {
      await deleteEmployee(employee.id);
      await loadData();
    } catch (err) {
      setError(err.response?.data?.detail || "Unable to delete employee.");
    }
  }

  return (
    <section className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold text-slate-900">Employees</h1>
        <p className="mt-1 text-sm text-slate-500">
          Manage employee records from your workforce database.
        </p>
      </div>

      {error && (
        <div role="alert" className="rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          {error}
        </div>
      )}

      {notice && (
        <div
          role="status"
          className="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"
        >
          {notice}
        </div>
      )}

      {linkingEmployee && (
        <form
          onSubmit={handleLinkAccount}
          className="space-y-4 rounded-xl border border-indigo-200 bg-white p-5"
        >
          <div>
            <h2 className="text-lg font-semibold text-slate-900">
              Link login account
            </h2>
            <p className="mt-1 text-sm text-slate-500">
              Employee: {linkingEmployee.full_name} (
              {linkingEmployee.employee_code})
            </p>
            <p className="mt-1 text-sm text-slate-500">
              Enter the email address of an existing user account.
            </p>
          </div>

          <label className="block text-sm font-medium text-slate-700">
            Login account email
            <input
              required
              type="email"
              maxLength={255}
              autoComplete="off"
              value={accountEmail}
              onChange={(event) => setAccountEmail(event.target.value)}
              placeholder="employee@company.com"
              className="mt-1 block w-full rounded-lg border border-slate-300 p-3 font-normal"
            />
          </label>

          <div className="flex flex-wrap gap-2">
            <button
              type="submit"
              disabled={linking}
              className="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white hover:bg-indigo-700 disabled:opacity-50"
            >
              {linking ? "Linking account..." : "Link account"}
            </button>

            <button
              type="button"
              disabled={linking}
              onClick={() => {
                setLinkingEmployee(null);
                setAccountEmail("");
                setError("");
              }}
              className="rounded-lg border border-slate-300 px-5 py-2.5"
            >
              Cancel
            </button>
          </div>
        </form>
      )}

      <form onSubmit={handleSubmit} className="grid gap-4 rounded-xl border border-slate-200 bg-white p-5 sm:grid-cols-2 lg:grid-cols-3">
        <h2 className="text-lg font-semibold sm:col-span-2 lg:col-span-3">
          {editingId !== null ? "Edit employee" : "Add employee"}
        </h2>

        <input required name="employee_code" maxLength={50} placeholder="Employee code"
          value={form.employee_code} onChange={handleChange}
          className="rounded-lg border p-3" />

        <input required name="full_name" maxLength={150} placeholder="Full name"
          value={form.full_name} onChange={handleChange}
          className="rounded-lg border p-3" />

        <input name="job_title" maxLength={100} placeholder="Job title"
          value={form.job_title} onChange={handleChange}
          className="rounded-lg border p-3" />

        <select name="department_id" value={form.department_id} onChange={handleChange}
          className="rounded-lg border bg-white p-3">
          <option value="">No department</option>
          {departments.map((department) => (
            <option key={department.id} value={department.id}>{department.name}</option>
          ))}
        </select>

        <input type="date" name="hire_date" value={form.hire_date}
          onChange={handleChange} className="rounded-lg border p-3" />

        <select name="employment_status" value={form.employment_status}
          onChange={handleChange} className="rounded-lg border bg-white p-3">
          <option value="Active">Active</option>
          <option value="Inactive">Inactive</option>
          <option value="On Leave">On Leave</option>
        </select>

        <div className="flex flex-wrap gap-2 sm:col-span-2 lg:col-span-3">
          <button type="submit" className="rounded-lg bg-indigo-600 px-5 py-2.5 font-medium text-white hover:bg-indigo-700">
            {editingId !== null ? "Save changes" : "Add employee"}
          </button>
          {editingId !== null && (
            <button type="button" onClick={() => { setEditingId(null); setForm(emptyForm); }}
              className="rounded-lg border px-5 py-2.5">
              Cancel
            </button>
          )}
        </div>
      </form>

      <div className="flex flex-col gap-3 sm:flex-row">
        <input placeholder="Search name or employee code" value={search}
          onChange={(e) => { setSearch(e.target.value); setPage(1); }}
          className="flex-1 rounded-lg border bg-white p-3" />

        <select value={departmentId}
          onChange={(e) => { setDepartmentId(e.target.value); setPage(1); }}
          className="rounded-lg border bg-white p-3">
          <option value="">All departments</option>
          {departments.map((department) => (
            <option key={department.id} value={department.id}>{department.name}</option>
          ))}
        </select>

        <button onClick={loadData} className="rounded-lg border bg-white px-4 py-2">
          Refresh
        </button>
      </div>

      <div className="overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table className="w-full text-left text-sm">
          <thead className="bg-slate-50 text-slate-600">
            <tr>
              {["Code", "Employee", "Department", "Job title", "Status", "Account", "Actions"].map((heading) => (
                <th key={heading} className="whitespace-nowrap px-4 py-3 font-semibold">{heading}</th>
              ))}
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-100">
            {loading ? (
              <tr><td colSpan="7" className="p-8 text-center">Loading employees...</td></tr>
            ) : employees.length === 0 ? (
              <tr><td colSpan="7" className="p-8 text-center text-slate-500">No employee records found.</td></tr>
            ) : employees.map((employee) => (
              <tr key={employee.id} className="hover:bg-slate-50">
                <td className="whitespace-nowrap px-4 py-3">{employee.employee_code}</td>
                <td className="whitespace-nowrap px-4 py-3 font-medium">{employee.full_name}</td>
                <td className="whitespace-nowrap px-4 py-3">
                  {departments.find((d) => d.id === employee.department_id)?.name || "—"}
                </td>
                <td className="whitespace-nowrap px-4 py-3">{employee.job_title || "—"}</td>
                <td className="whitespace-nowrap px-4 py-3">{employee.employment_status}</td>
                <td className="whitespace-nowrap px-4 py-3">
                  {employee.account_linked ? (
                    <span className="inline-flex rounded-full bg-emerald-50 px-2 py-1 text-xs font-medium text-emerald-700">
                      Linked
                    </span>
                  ) : (
                    <span className="inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">
                      Not linked
                    </span>
                  )}
                </td>
                <td className="whitespace-nowrap px-4 py-3">
                  {!employee.account_linked && (
                    <button
                      onClick={() => {
                        setError("");
                        setNotice("");
                        setLinkingEmployee(employee);
                        setAccountEmail("");
                        window.scrollTo({ top: 0, behavior: "smooth" });
                      }}
                      className="mr-3 font-medium text-emerald-700"
                    >
                      Link account
                    </button>
                  )}
                  <button onClick={() => startEdit(employee)} className="mr-3 font-medium text-indigo-600">Edit</button>
                  <button onClick={() => handleDelete(employee)} className="font-medium text-red-600">Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div className="flex items-center justify-between">
        <button disabled={page <= 1} onClick={() => setPage((p) => p - 1)}
          className="rounded-lg border px-4 py-2 disabled:opacity-40">Previous</button>
        <span className="text-sm text-slate-500">Page {page}</span>
        <button disabled={employees.length < 100} onClick={() => setPage((p) => p + 1)}
          className="rounded-lg border px-4 py-2 disabled:opacity-40">Next</button>
      </div>
    </section>
  );
}
