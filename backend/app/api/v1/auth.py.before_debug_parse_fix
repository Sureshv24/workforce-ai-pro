router = APIRouter(prefix="/auth", tags=["Authentication"])
logger = logging.getLogger(__name__)

RESET_EXPIRE_MINUTES = 30
GENERIC_RESET_MESSAGE = (
    "If an active account exists for that email, "
    "password reset instructions will be sent."
)


def utc_now_naive() -> datetime:
    """Use naive UTC for compatibility with MySQL DATETIME columns."""
    return datetime.now(timezone.utc).replace(tzinfo=None)


def token_digest(token: str) -> str:
    return hashlib.sha256(token.encode("utf-8")).hexdigest()


def read_setting(name: str, default=None):
    """Read a configured setting, environment variable, or backend .env value."""
    value = getattr(settings, name, None)
    if value not in (None, ""):
        return value

    value = os.environ.get(name)
    if value not in (None, ""):
        return value

    for env_path in (Path(".env"), Path("../.env")):
        if not env_path.is_file():
            continue
        try:
            for line in env_path.read_text(encoding="utf-8").splitlines():
                stripped = line.strip()
                if not stripped or stripped.startswith("#") or "=" not in stripped:
                    continue
                key, raw = stripped.split("=", 1)
                if key.strip() == name:
                    return raw.strip().strip('"').strip("'")
        except OSError:
            logger.warning("Could not read an environment configuration file.")
    return default


def smtp_configuration():
    host = read_setting("SMTP_HOST")
    sender = read_setting("SMTP_FROM_EMAIL")
    if not host or not sender:
        return None

    try:
        port = int(read_setting("SMTP_PORT", 587))
    except (TypeError, ValueError):
        logger.warning("SMTP_PORT is invalid.")
        return None

    return {
        "host": str(host),
        "port": port,
        "username": read_setting("SMTP_USERNAME"),
        "password": read_setting("SMTP_PASSWORD"),
        "sender": str(sender),
        "use_tls": str(read_setting("SMTP_USE_TLS", "true")).lower()
        in ("1", "true", "yes", "on"),
    }


def send_reset_email(email: str, reset_url: str, config: dict) -> None:
    message = EmailMessage()
    message["Subject"] = "Reset your WorkForce AI Pro password"
    message["From"] = config["sender"]
    message["To"] = email
    message.set_content(
        "A password reset was requested for your WorkForce AI Pro account.\n\n"
        f"Use this link within {RESET_EXPIRE_MINUTES} minutes:\n"
        f"{reset_url}\n\n"
        "If you did not request this change, ignore this email."
    )

    if config["port"] == 465:
        with smtplib.SMTP_SSL(
            config["host"], config["port"], timeout=15
        ) as server:
            if config["username"]:
                server.login(config["username"], config["password"] or "")
            server.send_message(message)
    else:
        with smtplib.SMTP(
            config["host"], config["port"], timeout=15
        ) as server:
            server.ehlo()
            if config["use_tls"]:
                server.starttls()
                server.ehlo()
            if config["username"]:
                server.login(config["username"], config["password"] or "")
            server.send_message(message)


def create_reset_token(db: Session, user: User):
    now = utc_now_naive()

    # A newer request invalidates all previously unused reset tokens.
    previous_tokens = db.scalars(
        select(PasswordResetToken).where(
            PasswordResetToken.user_id == user.id,
            PasswordResetToken.used_at.is_(None),
        )
    ).all()

    for previous in previous_tokens:
        previous.used_at = now

    raw_token = secrets.token_urlsafe(32)
    record = PasswordResetToken(
        user_id=user.id,
        token_hash=token_digest(raw_token),
        expires_at=now + timedelta(minutes=RESET_EXPIRE_MINUTES),
    )
    db.add(record)
    db.commit()
    return raw_token


@router.post(
    "/register",
    response_model=UserResponse,
    status_code=status.HTTP_201_CREATED,
)
def register(data: RegisterRequest, db: Session = Depends(get_db)):
    email = str(data.email).lower()
    existing = db.scalar(select(User).where(User.email == email))
    if existing:
        raise HTTPException(status_code=409, detail="Email is already registered")

    # Public registration cannot assign privileged roles.
    user = User(
        email=email,
        password_hash=hash_password(data.password),
        role="EMPLOYEE",
    )
    db.add(user)

    try:
        db.commit()
        db.refresh(user)
    except IntegrityError:
        db.rollback()
        raise HTTPException(status_code=409, detail="Email is already registered")

    return user


@router.post("/login", response_model=TokenResponse)
def login(data: LoginRequest, db: Session = Depends(get_db)):
    user = db.scalar(
        select(User).where(User.email == str(data.email).lower())
    )

    if (
        user is None
        or not verify_password(data.password, user.password_hash)
        or not user.is_active
    ):
        raise HTTPException(
            status_code=401,
            detail="Incorrect email or password",
            headers={"WWW-Authenticate": "Bearer"},
        )

    return TokenResponse(
        access_token=create_access_token(user.id, user.role)
    )


@router.get("/me", response_model=UserResponse)
def get_me(current_user: User = Depends(get_current_user)):
    return current_user


@router.post(
    "/forgot-password",
    response_model=ForgotPasswordResponse,
)
def forgot_password(
    data: ForgotPasswordRequest,
    db: Session = Depends(get_db),
):
    # Always return the same general message to avoid account enumeration.
    response = ForgotPasswordResponse(message=GENERIC_RESET_MESSAGE)
    email = str(data.email).lower()
    user = db.scalar(select(User).where(User.email == email))

    if user is None or not user.is_active:
        return response

    smtp = smtp_configuration()
    debug_mode = bool(read_setting("DEBUG", False))
    frontend_url = str(
        read_setting("FRONTEND_URL", "http://localhost:5173")
    ).rstrip("/")

    # Do not create an unusable token in production when email isn't configured.
    if smtp is None and not debug_mode:
        logger.warning(
            "Password reset email is not configured; no reset token was issued."
        )
        return response

    try:
        raw_token = create_reset_token(db, user)
        reset_url = f"{frontend_url}/?reset_token={raw_token}"

        if smtp is not None:
            try:
                send_reset_email(email, reset_url, smtp)
                return response
            except Exception:
                logger.exception("Password reset email delivery failed.")
                if not debug_mode:
                    stored = db.scalar(
                        select(PasswordResetToken).where(
                            PasswordResetToken.token_hash == token_digest(raw_token)
                        )
                    )
                    if stored is not None:
                        stored.used_at = utc_now_naive()
                        db.commit()
                    return response

        # Local development only: convenient when SMTP has not been configured.
        if debug_mode:
            response.debug_reset_url = reset_url
            return response

    except Exception:
        db.rollback()
        logger.exception("Could not create a password reset request.")

    return response


@router.post(
    "/reset-password",
    response_model=ResetPasswordResponse,
)
def reset_password(
    data: ResetPasswordRequest,
    db: Session = Depends(get_db),
):
    now = utc_now_naive()

    # Lock the record during validation and consumption to reduce replay races.
    record = db.scalar(
        select(PasswordResetToken)
        .where(PasswordResetToken.token_hash == token_digest(data.token))
        .with_for_update()
    )

    if (
        record is None
        or record.used_at is not None
        or record.expires_at <= now
    ):
        raise HTTPException(
            status_code=400,
            detail="Invalid or expired password reset token.",
        )

    user = db.get(User, record.user_id)
    if user is None or not user.is_active:
        raise HTTPException(
            status_code=400,
            detail="Invalid or expired password reset token.",
        )

    user.password_hash = hash_password(data.new_password)
    record.used_at = now

    # Invalidate any other outstanding tokens for this account as well.
    other_tokens = db.scalars(
        select(PasswordResetToken).where(
            PasswordResetToken.user_id == user.id,
            PasswordResetToken.id != record.id,
            PasswordResetToken.used_at.is_(None),
        )
    ).all()
    for other in other_tokens:
        other.used_at = now

    db.commit()
    return ResetPasswordResponse(
        message="Password reset successfully. Please sign in with your new password."
    )
