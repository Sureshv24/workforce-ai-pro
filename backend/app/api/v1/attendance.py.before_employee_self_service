from datetime import date, datetime, time, timedelta

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy import select
from sqlalchemy.exc import IntegrityError
from sqlalchemy.orm import Session

from app.api.deps import get_current_user
from app.db.session import get_db
from app.models.user import User
from app.models.employee import Employee
from app.models.attendance import Attendance, Shift
from app.schemas.attendance import (
    AttendanceCreate,
    AttendanceUpdate,
    AttendanceResponse,
    ShiftCreate,
    ShiftUpdate,
    ShiftResponse,
)

router = APIRouter(prefix="/attendance", tags=["Attendance"])


def require_hr(user: User):
    if user.role not in ("ADMIN", "HR"):
        raise HTTPException(
            status_code=403,
            detail="Admin or HR permission required",
        )


def validate_employee(db: Session, employee_id: int):
    employee = db.get(Employee, employee_id)
    if employee is None:
        raise HTTPException(status_code=404, detail="Employee not found")
    return employee


def validate_times(check_in, check_out):
    if check_in and check_out and check_out < check_in:
        raise HTTPException(
            status_code=422,
            detail="Check-out cannot be earlier than check-in",
        )




def validate_shift_values(start_time, end_time, break_minutes):
    start = datetime.combine(date.min, start_time)
    end = datetime.combine(date.min, end_time)
    if end <= start:
        end += timedelta(days=1)
    duration = int((end - start).total_seconds() // 60)
    if break_minutes >= duration:
        raise HTTPException(
            status_code=422,
            detail="Break must be shorter than the shift duration.",
        )


@router.get("/shifts", response_model=list[ShiftResponse])
def list_shifts(
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    return db.scalars(select(Shift).order_by(Shift.name)).all()


@router.post(
    "/shifts",
    response_model=ShiftResponse,
    status_code=status.HTTP_201_CREATED,
)
def create_shift(
    data: ShiftCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    validate_shift_values(data.start_time, data.end_time, data.break_minutes)

    shift = Shift(**data.model_dump())
    db.add(shift)
    try:
        db.commit()
        db.refresh(shift)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="A shift with this name may already exist.",
        )
    return shift


@router.patch("/shifts/{shift_id}", response_model=ShiftResponse)
def update_shift(
    shift_id: int,
    data: ShiftUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    shift = db.get(Shift, shift_id)
    if shift is None:
        raise HTTPException(status_code=404, detail="Shift not found")

    updates = data.model_dump(exclude_unset=True)
    start_time = updates.get("start_time", shift.start_time)
    end_time = updates.get("end_time", shift.end_time)
    break_minutes = updates.get("break_minutes", shift.break_minutes)
    validate_shift_values(start_time, end_time, break_minutes)

    for field, value in updates.items():
        setattr(shift, field, value)

    try:
        db.commit()
        db.refresh(shift)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="Shift name already exists or the update conflicts with existing records.",
        )
    return shift


@router.delete("/shifts/{shift_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_shift(
    shift_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    shift = db.get(Shift, shift_id)
    if shift is None:
        raise HTTPException(status_code=404, detail="Shift not found")

    db.delete(shift)
    try:
        db.commit()
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="This shift is assigned to attendance records and cannot be deleted.",
        )


@router.get("/", response_model=list[AttendanceResponse])
def list_attendance(
    employee_id: int | None = Query(default=None, gt=0),
    attendance_date: date | None = None,
    start_date: date | None = None,
    end_date: date | None = None,
    attendance_status: str | None = Query(default=None, alias="status"),
    page: int = Query(default=1, ge=1),
    page_size: int = Query(default=10, ge=1, le=100),
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)

    if start_date and end_date and start_date > end_date:
        raise HTTPException(
            status_code=422,
            detail="start_date cannot be after end_date",
        )

    query = select(Attendance)

    if employee_id is not None:
        query = query.where(Attendance.employee_id == employee_id)
    if attendance_date is not None:
        query = query.where(Attendance.attendance_date == attendance_date)
    if start_date is not None:
        query = query.where(Attendance.attendance_date >= start_date)
    if end_date is not None:
        query = query.where(Attendance.attendance_date <= end_date)
    if attendance_status:
        allowed = ("Present", "Absent", "Late", "On Leave")
        if attendance_status not in allowed:
            raise HTTPException(
                status_code=422,
                detail=f"status must be one of: {', '.join(allowed)}",
            )
        query = query.where(Attendance.status == attendance_status)

    return db.scalars(
        query.order_by(
            Attendance.attendance_date.desc(),
            Attendance.id.desc(),
        )
        .offset((page - 1) * page_size)
        .limit(page_size)
    ).all()


@router.post(
    "/",
    response_model=AttendanceResponse,
    status_code=status.HTTP_201_CREATED,
)
def create_attendance(
    data: AttendanceCreate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    validate_employee(db, data.employee_id)
    validate_times(data.check_in, data.check_out)
    if data.shift_id is not None and db.get(Shift, data.shift_id) is None:
        raise HTTPException(status_code=404, detail="Shift not found")

    existing = db.scalar(
        select(Attendance).where(
            Attendance.employee_id == data.employee_id,
            Attendance.attendance_date == data.attendance_date,
        )
    )
    if existing:
        raise HTTPException(
            status_code=409,
            detail="Attendance already exists for this employee and date",
        )

    record = Attendance(**data.model_dump())
    db.add(record)

    try:
        db.commit()
        db.refresh(record)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="Attendance already exists for this employee and date",
        )

    return record


@router.patch("/{attendance_id}", response_model=AttendanceResponse)
def update_attendance(
    attendance_id: int,
    data: AttendanceUpdate,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    record = db.get(Attendance, attendance_id)

    if record is None:
        raise HTTPException(status_code=404, detail="Attendance not found")

    updates = data.model_dump(exclude_unset=True)
    new_check_in = updates.get("check_in", record.check_in)
    new_check_out = updates.get("check_out", record.check_out)
    validate_times(new_check_in, new_check_out)

    new_date = updates.get("attendance_date", record.attendance_date)
    if "shift_id" in updates and updates["shift_id"] is not None:
        if db.get(Shift, updates["shift_id"]) is None:
            raise HTTPException(status_code=404, detail="Shift not found")

    duplicate = db.scalar(
        select(Attendance).where(
            Attendance.employee_id == record.employee_id,
            Attendance.attendance_date == new_date,
            Attendance.id != record.id,
        )
    )
    if duplicate:
        raise HTTPException(
            status_code=409,
            detail="Attendance already exists for this employee and date",
        )

    for field, value in updates.items():
        setattr(record, field, value)

    try:
        db.commit()
        db.refresh(record)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="Attendance conflicts with an existing record",
        )

    return record


@router.delete("/{attendance_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_attendance(
    attendance_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    record = db.get(Attendance, attendance_id)

    if record is None:
        raise HTTPException(status_code=404, detail="Attendance not found")

    db.delete(record)
    db.commit()


@router.post(
    "/{employee_id}/check-in",
    response_model=AttendanceResponse,
)
def check_in(
    employee_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    employee = validate_employee(db, employee_id)

    if employee.employment_status != "Active":
        raise HTTPException(
            status_code=409,
            detail="Only active employees can check in",
        )

    now = datetime.now().replace(microsecond=0)
    today = now.date()
    record = db.scalar(
        select(Attendance).where(
            Attendance.employee_id == employee_id,
            Attendance.attendance_date == today,
        )
    )

    if record is not None:
        if record.check_in is not None:
            raise HTTPException(
                status_code=409,
                detail="Employee has already checked in today",
            )
        record.check_in = now
        record.status = "Present"
    else:
        record = Attendance(
            employee_id=employee_id,
            attendance_date=today,
            check_in=now,
            status="Present",
        )
        db.add(record)

    try:
        db.commit()
        db.refresh(record)
    except IntegrityError:
        db.rollback()
        raise HTTPException(
            status_code=409,
            detail="Attendance already exists for today",
        )

    return record


@router.post(
    "/{employee_id}/check-out",
    response_model=AttendanceResponse,
)
def check_out(
    employee_id: int,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    validate_employee(db, employee_id)

    today = date.today()
    record = db.scalar(
        select(Attendance).where(
            Attendance.employee_id == employee_id,
            Attendance.attendance_date == today,
        )
    )

    if record is None or record.check_in is None:
        raise HTTPException(
            status_code=409,
            detail="Employee must check in before checking out",
        )
    if record.check_out is not None:
        raise HTTPException(
            status_code=409,
            detail="Employee has already checked out today",
        )

    record.check_out = datetime.now().replace(microsecond=0)

    try:
        db.commit()
        db.refresh(record)
    except Exception:
        db.rollback()
        raise HTTPException(status_code=500, detail="Could not save check-out")

    return record




@router.get("/reports")
def attendance_report(
    start_date: date,
    end_date: date,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)

    if start_date > end_date:
        raise HTTPException(
            status_code=422,
            detail="start_date cannot be after end_date",
        )
    if (end_date - start_date).days > 365:
        raise HTTPException(
            status_code=422,
            detail="Report range cannot exceed 366 calendar days.",
        )

    records = db.scalars(
        select(Attendance)
        .where(
            Attendance.attendance_date >= start_date,
            Attendance.attendance_date <= end_date,
        )
        .order_by(Attendance.attendance_date, Attendance.employee_id)
    ).all()

    counts = {"Present": 0, "Absent": 0, "Late": 0, "On Leave": 0}
    daily = {}
    employee_summary = {}
    worked_values = []
    overtime_values = []

    bucket_date = start_date
    while bucket_date <= end_date:
        daily[bucket_date.isoformat()] = {
            "date": bucket_date.isoformat(),
            "total_records": 0,
            "counts": {"Present": 0, "Absent": 0, "Late": 0, "On Leave": 0},
            "worked_minutes": 0,
            "worked_records": 0,
            "overtime_minutes": 0,
            "overtime_records": 0,
        }
        bucket_date += timedelta(days=1)

    for record in records:
        counts[record.status] = counts.get(record.status, 0) + 1
        day = daily[record.attendance_date.isoformat()]
        day["total_records"] += 1
        day["counts"][record.status] = day["counts"].get(record.status, 0) + 1

        employee_id = record.employee_id
        employee_item = employee_summary.setdefault(employee_id, {
            "employee_id": employee_id,
            "total_records": 0,
            "counts": {"Present": 0, "Absent": 0, "Late": 0, "On Leave": 0},
            "worked_minutes": 0,
            "worked_records": 0,
            "overtime_minutes": 0,
            "overtime_records": 0,
        })
        employee_item["total_records"] += 1
        employee_item["counts"][record.status] = (
            employee_item["counts"].get(record.status, 0) + 1
        )

        if record.worked_minutes is not None:
            worked_values.append(record.worked_minutes)
            day["worked_minutes"] += record.worked_minutes
            day["worked_records"] += 1
            employee_item["worked_minutes"] += record.worked_minutes
            employee_item["worked_records"] += 1

        if record.overtime_minutes is not None:
            overtime_values.append(record.overtime_minutes)
            day["overtime_minutes"] += record.overtime_minutes
            day["overtime_records"] += 1
            employee_item["overtime_minutes"] += record.overtime_minutes
            employee_item["overtime_records"] += 1

    return {
        "start_date": start_date,
        "end_date": end_date,
        "total_records": len(records),
        "counts": counts,
        "total_worked_minutes": sum(worked_values) if worked_values else None,
        "worked_records_count": len(worked_values),
        "total_overtime_minutes": sum(overtime_values) if overtime_values else None,
        "overtime_records_count": len(overtime_values),
        "daily_summary": list(daily.values()),
        "employee_summary": list(employee_summary.values()),
    }

@router.get("/summary/daily")
def daily_attendance_summary(
    attendance_date: date | None = None,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user),
):
    require_hr(current_user)
    target_date = attendance_date or date.today()

    records = db.scalars(
        select(Attendance).where(
            Attendance.attendance_date == target_date
        )
    ).all()

    counts = {
        "Present": 0,
        "Absent": 0,
        "Late": 0,
        "On Leave": 0,
    }
    for record in records:
        counts[record.status] = counts.get(record.status, 0) + 1

    return {
        "attendance_date": target_date,
        "total_records": len(records),
        "counts": counts,
    }
